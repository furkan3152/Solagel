# ───────── Elymum game server ─────────
PORT=8787
HOST=0.0.0.0
# Where the journal (money owed!), leaderboards, profiles, the contracts registry, the server key (auto)
# and the site data are stored. Use a persistent volume in production.
DATA_DIR=./data
# Random secret for login tokens (openssl rand -hex 32). Without it, players re-sign after every restart.
AUTH_SECRET=
# Allowed origin for REST calls ("*" is fine when the client is served by this server)
CORS_ORIGIN=*
# Set to 1 behind a reverse proxy (uses X-Forwarded-For for per-IP limits: the right-most hop, i.e. the
# address your proxy saw; with several proxies in a chain set TRUST_PROXY_HOPS to their number, default 1)
TRUST_PROXY=0
# TRUST_PROXY_HOPS=1
# REQUIRED unless NODE_ENV=development: public base URL of this server (e.g. https://elymum.io), the origin
# SIWE sign-ins are bound to and the base of the NFT metadata links (/api/nft/<id>). The server refuses to
# start without it. Only NODE_ENV=development may leave it empty (then the request's Host header is used;
# X-Forwarded-Host is never trusted for this).
PUBLIC_URL=
# Serve the built web client from this folder (single-origin deploy). Leave empty if hosting the client elsewhere.
WEB_DIST=

# Rooms & bots
# Humans per practice room (rookie and pro leagues each fill their busiest room first)
PRACTICE_CAPACITY=40
PRIVATE_ROOM_CAPACITY=20
# Humans per arena instance; a further instance (arena-<id>-<n>) opens when every instance is at the cap
ARENA_INSTANCE_CAP=50
# Practice bots: population target (humans + bots), floor and ceiling
BOT_TARGET=20
BOT_MIN=4
BOT_MAX=20
# Arena bots (zero-value; a bot eating a staker spills loot)
ARENA_BOT_TARGET=24
ARENA_BOT_MIN=2
ARENA_BOT_MAX=16
PRIVATE_BOT_TARGET=8
# Arena rounds (paid arenas): wall-clock round length and the closed-join window before the bell.
# The defaults are 300 and 60; the window is capped at half a round. Shorten them for a demo or a test.
# ROUND_SECONDS=300
# ROUND_JOIN_CLOSE_SECONDS=60
MAX_CONNECTIONS=600
MAX_CONNECTIONS_PER_IP=8

# ───────── Elysium (EVM L2, gas token HYPE) ─────────
# Leave EVM_RPC_URL empty for practice only (no arenas, no mint).
# RPC used by the server: its eth_chainId is the source of truth for the chain the site uses.
# May contain an API key (it is never sent to browsers). Elysium Testnet (chain id 99801):
EVM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# RPC handed to browsers (no secrets). Default: EVM_RPC_URL when it is the public testnet RPC, else
# empty (the wallet's own RPC is used).
PUBLIC_RPC_URL=
# Display name and Blockscout-style explorer for a chain id not in the table (mainnet, published at launch).
# The testnet's are built in (Elysium Testnet, https://explorer-elysium-testnet.t.conduit.xyz).
CHAIN_NAME=
EXPLORER_URL=
# The server's signing key: it is the arena's server authority (settlements, loot burns) and may be the
# NFT price keeper. It pays gas in HYPE: keep a little HYPE on it (a low balance is logged and shown in /admin).
#   auto      generated once into DATA_DIR/server-key.json (mode 0600); its address is logged and shown as
#             `serverKey` in /api/config: use it as the server authority when deploying the arena in /admin
#   0x…       a hex private key
#   /path     a file holding one
SERVER_PRIVATE_KEY=auto
# Optional overrides. Normally the addresses come from the registry the admin panel writes
# (DATA_DIR/contracts.json) after deploying from the owner's wallet; a newly registered arena is
# picked up without a restart. The game token is NOT configured here: it is read from the arena
# (`setToken` from /admin); until it is set the server plays practice only and re-reads every 30 s.
ARENA_ADDRESS=
NFT_ADDRESS=
# Turn the token arenas on/off without touching the chain
STAKE_ENABLED=true
# Restrict stake rooms to these arena ids (empty = every enabled arena on-chain)
STAKE_ARENA_IDS=
# Display symbol of the game token (display only; the token is read on-chain). Default: $ELYMUM
# (left commented: some env loaders expand "$NAME" inside values)
# TOKEN_SYMBOL=$ELYMUM
# Unplayed tickets are settled at their entry fee after this many seconds (default 900)
# STALE_SESSION_AFTER_S=900
# Blocks per eth_getLogs request (session and holder indexes); lower it if the RPC limits log ranges
# LOG_CHUNK_BLOCKS=10000

# ───────── NFT mint ($1 in HYPE) ─────────
# Mint target in US cents (default 100 = $1). The HYPE/USD price comes from Hyperliquid's info API.
MINT_USD_CENTS=100
HYPE_PRICE_URL=https://api.hyperliquid.xyz/info

# ───────── Development only ─────────
# DEV_FAKE_CHAIN=1 runs an in-memory fake chain instead of Elysium: the game token starts unset
# (practice only, arenas "opening soon"); `curl -X POST localhost:8787/api/dev/token` sets it, like
# `setToken` from /admin, and the arenas open without a restart. With DEV_FAKE_TOKEN=1 it starts set.
# Then every signed-in wallet gets free arena tickets, and settlements are simulated ~2.6 s after a
# round end or death (fake 0x hashes). For local UI work and Playwright. It needs an explicit
# NODE_ENV=development, refuses to start when EVM_RPC_URL or SERVER_PRIVATE_KEY is set, and keeps its
# own DATA_DIR files (journal.dev-fake.json, leaderboards.dev-fake.json, profiles.dev-fake.json).
# Never set it on a deployed server.
#   NODE_ENV=development DEV_FAKE_CHAIN=1 DEV_FAKE_TOKEN=1 EVM_RPC_URL= SERVER_PRIVATE_KEY= pnpm dev:server
DEV_FAKE_CHAIN=
DEV_FAKE_TOKEN=

# ───────── Site and game access ─────────
# Admin wallets (comma-separated 0x addresses) allowed to use /admin and /api/admin/*, and to play
# whatever the game access is. NO default: when empty, a loud warning is logged and nobody is admin.
ADMIN_WALLETS=
# Who may play (practice, arenas, private rooms, spectating): admins | holders | public.
# holders = wallets holding an Elymum NFT (balanceOf > 0, cached 60 s) plus the admins.
# Empty: the admin's `gameAccess` setting decides (default admins).
GAME_ACCESS=
