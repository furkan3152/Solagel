# ───────── Slana game server ─────────
PORT=8787
HOST=0.0.0.0
# Where the journal (money owed!) and leaderboards are stored. Use a persistent volume in production.
DATA_DIR=./data
# Random secret for login tokens (openssl rand -hex 32). Without it, players re-sign after every restart.
AUTH_SECRET=
# Allowed origin for REST calls ("*" is fine when the client is served by this server)
CORS_ORIGIN=*
# Set to 1 behind a reverse proxy (uses X-Forwarded-For for per-IP limits)
TRUST_PROXY=0
# Public base URL of this server, used for Slana Pass metadata image links (https://slana.example).
# Empty: derived from the request's Host header (X-Forwarded-Proto/Host with TRUST_PROXY=1),
# falling back to http://localhost:<PORT>. Set it in production: marketplaces cache these links.
PUBLIC_URL=
# Serve the built web client from this folder (single-origin deploy). Leave empty if hosting the client elsewhere.
WEB_DIST=

# Rooms & bots
# Humans per practice room (rookie and pro leagues each fill their busiest room first)
PRACTICE_CAPACITY=40
PRIVATE_ROOM_CAPACITY=20
# Humans per arena instance; a further instance (arena-<id>-<n>) opens when every instance is at the cap
ARENA_INSTANCE_CAP=50
# Practice bots: population target (humans + bots), floor and ceiling
BOT_TARGET=20
BOT_MIN=4
BOT_MAX=20
# Arena bots (zero-value; a bot eating a staker spills loot)
ARENA_BOT_TARGET=24
ARENA_BOT_MIN=2
ARENA_BOT_MAX=16
PRIVATE_BOT_TARGET=8
# Slana Pass power: start-mass multiplier and cash-out time (ms)
PASS_START_MASS_MUL=1.15
PASS_CASHOUT_MS=2000
MAX_CONNECTIONS=600
MAX_CONNECTIONS_PER_IP=8

# ───────── Solana (leave PROGRAM_ID / SERVER_KEYPAIR empty for free play only) ─────────
# localnet | devnet | mainnet-beta
SOLANA_CLUSTER=devnet
# RPC used by the server (a paid RPC is strongly recommended on mainnet; may contain an API key)
SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC advertised to browsers — must NOT contain secrets
PUBLIC_RPC_URL=
# Deployed program id (target/deploy/slana-keypair.json pubkey)
PROGRAM_ID=
# Server authority keypair: a path to a keypair JSON file, or the JSON array itself.
# Must equal config.server_authority on-chain. Keep a little SOL on it: it pays settlement fees (sessions deposit settle_fee_lamports to reimburse it). It never pays for player token accounts.
SERVER_KEYPAIR=
# Turn the token arenas on/off without touching the chain
STAKE_ENABLED=true
# Restrict stake rooms to these arena ids (empty = every enabled arena on-chain)
STAKE_ARENA_IDS=
# Display symbol of the game token (display only; the mint is read on-chain). Default: $SLANA
# (left commented: some env loaders expand "$NAME" inside values)
# TOKEN_SYMBOL=$SLANA
# Priority fee for settlement transactions (micro-lamports per compute unit)
PRIORITY_FEE_MICROLAMPORTS=5000
