{
  "name": "@elymum/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Elymum game server: simulation, rooms, smart bots, settlement on Elysium",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "integrity-sim": "tsx scripts/integrity-sim.ts",
    "bot-bench": "tsx scripts/bench/bot-bench.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@elymum/sdk": "workspace:*",
    "@elymum/shared": "workspace:*",
    "viem": "^2.57.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
