{
  "name": "@slana/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Slana game server: simulation, rooms, smart bots, Solana settlement",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@napi-rs/canvas": "^1.0.11",
    "@slana/art": "workspace:*",
    "@slana/sdk": "workspace:*",
    "@slana/shared": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
