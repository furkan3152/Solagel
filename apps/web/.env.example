# Game server URL when the client is hosted separately (e.g. Vercel). Leave empty when the
# game server serves the client itself (same origin) or in `pnpm dev` (Vite proxies /ws and /api).
VITE_SERVER_URL=
# Optional RPC override for the browser (otherwise the server-advertised public RPC is used,
# and without one the wallet's own RPC).
VITE_RPC_URL=
# Absolute site URL for the canonical link and the Open Graph / X card tags in index.html
# (no trailing slash). Defaults to PUBLIC_URL, else https://elymum.io.
VITE_PUBLIC_URL=
