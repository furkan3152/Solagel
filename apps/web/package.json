{
  "name": "@slana/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slana web client: cute coin renderer, lobby, HUD and Solana wallet integration",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "shot": "node scripts/shot.mjs",
    "tour": "node scripts/tour.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@slana/art": "workspace:*",
    "@slana/sdk": "workspace:*",
    "@slana/shared": "workspace:*",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
