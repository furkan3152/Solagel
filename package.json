{
  "name": "elymum",
  "private": true,
  "version": "0.1.0",
  "description": "Elymum: a cute coin-eats-coin arena game on Elysium (EVM, gas HYPE), with the Elymum NFT",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:localnet": "node scripts/demo.mjs --localnet",
    "demo:record": "node scripts/record-walkthrough.mjs",
    "dev": "pnpm -r --parallel --filter @elymum/server --filter @elymum/web dev",
    "dev:server": "pnpm -F @elymum/server dev",
    "dev:web": "pnpm -F @elymum/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "contracts:build": "pnpm -F @elymum/contracts build",
    "contracts:test": "pnpm -F @elymum/contracts test",
    "localnet": "node scripts/localnet.mjs",
    "localnet:fund": "node scripts/localnet-fund.mjs",
    "admin": "pnpm -F @elymum/sdk admin"
  }
}
