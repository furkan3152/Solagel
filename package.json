{
  "name": "solagel",
  "private": true,
  "version": "0.1.0",
  "description": "Solagel — cute coin-themed on-chain Agar.io for Solana",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @solagel/server --filter @solagel/web dev",
    "dev:server": "pnpm -F @solagel/server dev",
    "dev:web": "pnpm -F @solagel/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "program:build": "anchor build",
    "program:test": "anchor build && cargo test -p solagel",
    "admin": "pnpm -F @solagel/sdk admin"
  }
}
