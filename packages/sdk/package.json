{
  "name": "@elymum/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client + admin CLI for the Slana Anchor program",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ops": "./src/ops.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
