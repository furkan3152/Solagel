  },
  "dependencies": {
    "@elymum/contracts": "workspace:*",
    "@elymum/shared": "workspace:*",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
