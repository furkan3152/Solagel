# Elymum game server on the VPS: /opt/elymum/.env (mode 600, never committed).
# Lines marked [FROM RENDER] must be copied from Render → the game service → Environment, value for value.
# No real secret belongs in this example file.
#
# Format: KEY=value, one per line, no spaces around "=". docker compose reads this file and expands "$NAME"
# inside unquoted values: put a value containing "$" in single quotes ('like$this').
#
# Set by docker-compose.yml, ignored here: DATA_DIR=/data, PORT=8787, HOST=0.0.0.0, TRUST_PROXY=1,
# TRUST_PROXY_HOPS=1 (Caddy is the one proxy in front and sets X-Forwarded-For itself).

# ───────── This VPS ─────────
# The game server's own domain (Caddy gets its HTTPS certificate). DNS: an A record to this server's IP.
GAME_DOMAIN=game.elymum.io

# ───────── Required ─────────
NODE_ENV=production
# [FROM RENDER] The SITE's origin (where players sign in), not this server's: keep https://elymum.io.
# It is the domain wallet sign-ins (SIWE) are bound to and the base of the NFT metadata links.
PUBLIC_URL=https://elymum.io
# The web (Vercel) calls this server from https://elymum.io: allow exactly that origin.
CORS_ORIGIN=https://elymum.io
# [FROM RENDER] Owner / admin wallets, comma-separated 0x addresses. Empty: nobody is admin.
ADMIN_WALLETS=
# [FROM RENDER] Login token secret (openssl rand -hex 32). Copy Render's value so sessions stay valid.
# (Left empty, the server keeps DATA_DIR/auth-secret, which the backup carries over too.)
AUTH_SECRET=
# [FROM RENDER] The server's signing key: auto (DATA_DIR/server-key.json, carried over by the backup),
# a 0x hex key, or a file path. With "auto" (Render's default), restoring the backup is what keeps the same
# key (the arena's server authority). If Render has a 0x key: keep "auto" here until the cutover and paste
# the key only once Render is suspended (two servers must never run with the same key; README step 5).
SERVER_PRIVATE_KEY=auto

# ───────── Chain ─────────
# [FROM RENDER] Server RPC (may hold an API key; never sent to browsers).
EVM_RPC_URL=
# [FROM RENDER, if set] RPC handed to browsers (no secrets).
PUBLIC_RPC_URL=
# [FROM RENDER, if set] Elysium Testnet RPC for "import testnet emblem holders" after the move to mainnet.
TESTNET_RPC_URL=
# [FROM RENDER, if set] Display name and explorer of a chain the code does not know (mainnet).
CHAIN_NAME=
EXPLORER_URL=
# [FROM RENDER, if set] Overrides of the registry /admin writes (normally empty).
ARENA_ADDRESS=
NFT_ADDRESS=
TOKEN_ADDRESS=
# [FROM RENDER, if set] Testnet escape hatch only: the old arena whose unsent journal records are set aside.
# Never on mainnet.
JOURNAL_ABANDON_CONTRACT=
# [FROM RENDER, if set] Only after reviewing a quarantined journal (journal.json.corrupt-*): 1
STALE_SWEEP_ACK=
# Token arenas on/off, and an optional list of arena ids (empty = every enabled arena on chain)
STAKE_ENABLED=true
STAKE_ARENA_IDS=
# Display symbol of the game token (default $ELYMUM; quote it if you set it)
# TOKEN_SYMBOL='$ELYMUM'
# Unplayed tickets are settled at their entry fee after this many seconds (default 900)
# STALE_SESSION_AFTER_S=900
# Blocks per eth_getLogs request (default 50000; lower it if the RPC limits log ranges)
# LOG_CHUNK_BLOCKS=50000
# The server's request budget on the RPC: calls per second and burst (defaults 4 and 8)
# RPC_MAX_RPS=4
# RPC_BURST=8
# Testnet staked-bot ticket purchases per minute (default 4)
# BOT_TICKETS_PER_MIN=4
# HYPE (gas) faucet linked from /faucet
# HYPE_FAUCET_URL=https://elysium.kinetiq.xyz/testnet-faucet

# ───────── Game access ─────────
# admins | holders | public. Empty: the /admin setting decides. [FROM RENDER, if set]
GAME_ACCESS=

# ───────── NFT mint ─────────
# Mint target in US cents (default 100 = $1) and the HYPE/USD feed
MINT_USD_CENTS=100
# HYPE_PRICE_URL=https://api.hyperliquid.xyz/info

# ───────── Capacity (defaults suit a 4-6 vCore VPS; copy Render's if you changed them there) ─────────
# Total WebSocket connections, and per client IP (players behind one home router share an IP)
MAX_CONNECTIONS=600
MAX_CONNECTIONS_PER_IP=8
# Humans per practice room, per private room, per arena instance
# PRACTICE_CAPACITY=40
# PRIVATE_ROOM_CAPACITY=20
# ARENA_INSTANCE_CAP=50
# Bot population defaults (the /admin bot settings win once saved)
# BOT_TARGET=12
# BOT_MIN=4
# BOT_MAX=12
# ARENA_BOT_TARGET=12
# ARENA_BOT_MIN=2
# ARENA_BOT_MAX=12
# PRIVATE_BOT_TARGET=8
# Arena round clock in seconds (defaults 300 and 60): leave unset in production
# ROUND_SECONDS=300
# ROUND_JOIN_CLOSE_SECONDS=60

# ───────── Never on this server ─────────
# DEV_FAKE_CHAIN and DEV_FAKE_TOKEN are for local development only. WEB_DIST is set by the image.
