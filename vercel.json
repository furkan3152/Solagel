{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "git config --global url.\"https://github.com/\".insteadOf \"git@github.com:\" && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -F @elymum/web build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://slana-wo00.onrender.com/api/:path*" },
    { "source": "/((?!api/|ws|assets/).*)", "destination": "/index.html" }
  ]
}
